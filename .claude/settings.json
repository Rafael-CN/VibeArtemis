{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/codemap/codemap.mjs:*)",
      "Bash(node tools/codemap/query.mjs:*)",
      "Bash(node tools/codemap/jni-check.mjs:*)",
      "Bash(node tools/validate.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git submodule status:*)",
      "Bash(./gradlew:*)",
      "Bash(adb logcat:*)",
      "Bash(ndk-stack:*)"
    ],
    "deny": [
      "Read(./docs/maps/code-index.json)",
      "Read(./docs/maps/SYMBOLS.md)",
      "Read(./app/build/**)",
      "Read(./**/*.apk)",
      "Read(./**/*.so)",
      "Read(./**/*.a)",
      "Read(./local.properties)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-jni.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-validate.mjs\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
